=== 2. Add handleDeleteTask function (after handleCancelTask) ===

func handleDeleteTask(w http.ResponseWriter, r *http.Request, taskID string) {
	// Only allow deleting done, blocked, or cancelled tasks
	row := db.QueryRow("SELECT id, status, title FROM tasks WHERE id = ?", taskID)
	var task Task
	if err := row.Scan(&task.ID, &task.Status, &task.Title); err != nil {
		http.Error(w, "task not found", http.StatusNotFound)
		return
	}

	allowed := map[string]bool{"done": true, "blocked": true, "cancelled": true}
	if !allowed[task.Status] {
		http.Error(w, fmt.Sprintf("cannot delete task in status '%s' — only done/blocked/cancelled", task.Status), http.StatusConflict)
		return
	}

	_, err := db.Exec("DELETE FROM tasks WHERE id = ?", taskID)
	if err != nil {
		http.Error(w, fmt.Sprintf("delete failed: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]string{
		"deleted": taskID,
		"title":   task.Title,
	})
}


