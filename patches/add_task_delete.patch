@mcp.tool()
def purge_tasks(status: str = "done", agent_id: str = "") -> str:
    """Bulk delete tasks by status. Only done/blocked/cancelled allowed.
    Set agent_id to identify yourself."""
    aid = _agent(agent_id)
    resp = requests.delete(
        f"{SLINKD_HOST}/tasks",
        headers=_headers(),
        params={"status": status},
        timeout=10,
    )
    resp.raise_for_status()
    data = resp.json()
    return f"Purged {data.get('deleted_count', 0)} tasks with status '{status}'"


