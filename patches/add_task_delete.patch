With:

func handleTasksTopLevel(w http.ResponseWriter, r *http.Request) {
	if r.Method == http.MethodGet {
		projectID := r.URL.Query().Get("project")
		handleListTasks(w, r, projectID)
		return
	}
	if r.Method == http.MethodDelete {
		// Bulk purge: DELETE /tasks?status=done
		status := r.URL.Query().Get("status")
		if status == "" {
			http.Error(w, "must specify ?status= to bulk delete (e.g. ?status=done)", http.StatusBadRequest)
			return
		}
		allowed := map[string]bool{"done": true, "blocked": true, "cancelled": true}
		if !allowed[status] {
			http.Error(w, fmt.Sprintf("cannot bulk delete status '%s' — only done/blocked/cancelled", status), http.StatusConflict)
			return
		}
		result, err := db.Exec("DELETE FROM tasks WHERE status = ?", status)
		if err != nil {
			http.Error(w, fmt.Sprintf("bulk delete failed: %v", err), http.StatusInternalServerError)
			return
		}
		count, _ := result.RowsAffected()
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"deleted_count": count,
			"status":        status,
		})
		return
	}
	http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
}


=== 4. Add MCP tool to slinkd_mcp.py ===

